CREATE TABLE public.orders (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  order_number text NOT NULL DEFAULT ('PL-'::text || upper(substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 12))) UNIQUE,
  customer_id uuid,
  customer_name text NOT NULL CHECK (char_length(btrim(customer_name)) >= 1 AND char_length(btrim(customer_name)) <= 150),
  customer_phone text NOT NULL CHECK (char_length(btrim(customer_phone)) >= 7 AND char_length(btrim(customer_phone)) <= 32),
  customer_email text CHECK (customer_email IS NULL OR customer_email ~* '^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$'::text),
  shipping_address_snapshot jsonb NOT NULL CHECK (jsonb_typeof(shipping_address_snapshot) = 'object'::text),
  customer_note text CHECK (customer_note IS NULL OR char_length(customer_note) <= 1000),
  currency text NOT NULL DEFAULT 'PKR'::text CHECK (currency ~ '^[A-Z]{3}$'::text),
  subtotal numeric NOT NULL CHECK (subtotal >= 0::numeric),
  delivery_fee numeric NOT NULL DEFAULT 0 CHECK (delivery_fee >= 0::numeric),
  discount_amount numeric NOT NULL DEFAULT 0,
  total numeric DEFAULT ((subtotal + delivery_fee) - discount_amount),
  order_status USER-DEFINED NOT NULL DEFAULT 'pending'::order_status,
  payment_method USER-DEFINED NOT NULL DEFAULT 'unconfirmed'::payment_method,
  payment_status USER-DEFINED NOT NULL DEFAULT 'pending'::payment_status,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  delivery_lat numeric CHECK (delivery_lat IS NULL OR delivery_lat >= '-90'::integer::numeric AND delivery_lat <= 90::numeric),
  delivery_lng numeric CHECK (delivery_lng IS NULL OR delivery_lng >= '-180'::integer::numeric AND delivery_lng <= 180::numeric),
  delivery_location_name text,
  delivery_location_captured_at timestamp with time zone,
  idempotency_key text CHECK (idempotency_key IS NULL OR char_length(idempotency_key) >= 8 AND char_length(idempotency_key) <= 120),
  confirmation_status text NOT NULL DEFAULT 'pending'::text CHECK (confirmation_status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'not_reachable'::text, 'cancelled'::text])),
  confirmed_at timestamp with time zone,
  confirmed_by uuid,
  confirmation_note text,
  expected_delivery_date date,
  delivery_window_start time without time zone,
  delivery_window_end time without time zone,
  delivery_note text,
  delivery_timing_confirmed_at timestamp with time zone,
  delivery_timing_confirmed_by uuid,
  delivered_at timestamp with time zone,
  CONSTRAINT orders_pkey PRIMARY KEY (id),
  CONSTRAINT orders_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES auth.users(id),
  CONSTRAINT orders_confirmed_by_fkey FOREIGN KEY (confirmed_by) REFERENCES auth.users(id),
  CONSTRAINT orders_delivery_timing_confirmed_by_fkey FOREIGN KEY (delivery_timing_confirmed_by) REFERENCES auth.users(id)
);
CREATE TABLE public.order_items (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  order_id uuid NOT NULL,
  product_id uuid,
  variant_id uuid,
  product_name_snapshot text NOT NULL,
  sku_snapshot text,
  variant_snapshot jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(variant_snapshot) = 'object'::text),
  product_snapshot jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(product_snapshot) = 'object'::text),
  quantity integer NOT NULL CHECK (quantity >= 1 AND quantity <= 99),
  unit_price numeric NOT NULL CHECK (unit_price >= 0::numeric),
  line_total numeric DEFAULT (unit_price * (quantity)::numeric),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  seller_id uuid,
  seller_name_snapshot text,
  vendor_fulfillment_status text NOT NULL DEFAULT 'pending'::text CHECK (vendor_fulfillment_status = ANY (ARRAY['pending'::text, 'accepted'::text, 'processing'::text, 'shipped'::text, 'delivered'::text, 'cancelled'::text])),
  tracking_number text,
  tracking_url text CHECK (tracking_url IS NULL OR tracking_url ~ '^https://'::text),
  vendor_note text CHECK (vendor_note IS NULL OR char_length(vendor_note) <= 1000),
  vendor_updated_at timestamp with time zone,
  collected_amount numeric,
  collected_at timestamp with time zone,
  CONSTRAINT order_items_pkey PRIMARY KEY (id),
  CONSTRAINT order_items_order_id_fkey FOREIGN KEY (order_id) REFERENCES public.orders(id),
  CONSTRAINT order_items_product_id_fkey FOREIGN KEY (product_id) REFERENCES public.products(id),
  CONSTRAINT order_items_variant_id_fkey FOREIGN KEY (variant_id) REFERENCES public.product_variants(id),
  CONSTRAINT order_items_seller_id_fkey FOREIGN KEY (seller_id) REFERENCES public.seller_profiles(id)
);
CREATE TABLE public.payment_transactions (
