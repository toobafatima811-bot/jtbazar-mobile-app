  contact_email text CHECK (contact_email IS NULL OR contact_email ~* '^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$'::text),
  status USER-DEFINED NOT NULL DEFAULT 'pending'::seller_status,
