  user_id uuid NOT NULL,
  recipient_name text NOT NULL CHECK (char_length(btrim(recipient_name)) >= 1 AND char_length(btrim(recipient_name)) <= 150),
  phone text NOT NULL CHECK (char_length(btrim(phone)) >= 7 AND char_length(btrim(phone)) <= 32),
