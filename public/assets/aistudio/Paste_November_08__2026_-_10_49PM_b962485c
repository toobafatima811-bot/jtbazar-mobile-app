CREATE TABLE public.profiles (
  id uuid NOT NULL,
  full_name text CHECK (full_name IS NULL OR char_length(btrim(full_name)) >= 1 AND char_length(btrim(full_name)) <= 150),
  phone text CHECK (phone IS NULL OR char_length(btrim(phone)) >= 7 AND char_length(btrim(phone)) <= 32),
  avatar_url text CHECK (avatar_url IS NULL OR avatar_url ~ '^https://'::text),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT profiles_pkey PRIMARY KEY (id),
  CONSTRAINT profiles_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id)
);
CREATE TABLE public.user_roles (
  user_id uuid NOT NULL,
  role USER-DEFINED NOT NULL,
  assigned_at timestamp with time zone NOT NULL DEFAULT now(),
  assigned_by uuid,
  CONSTRAINT user_roles_pkey PRIMARY KEY (user_id, role),
  CONSTRAINT user_roles_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id),
  CONSTRAINT user_roles_assigned_by_fkey FOREIGN KEY (assigned_by) REFERENCES auth.users(id)
);
CREATE TABLE public.categories (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  parent_id uuid,
  name text NOT NULL CHECK (char_length(btrim(name)) >= 1 AND char_length(btrim(name)) <= 160),
  slug text NOT NULL UNIQUE CHECK (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text),
  description text NOT NULL DEFAULT ''::text,
  eyebrow text,
  image_url text CHECK (image_url IS NULL OR image_url ~ '^https://'::text),
  is_active boolean NOT NULL DEFAULT false,
  sort_order integer NOT NULL DEFAULT 0 CHECK (sort_order >= 0),
  seo_title text,
  seo_description text,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  is_coming_soon boolean NOT NULL DEFAULT false,
  is_food_category boolean NOT NULL DEFAULT false,
  CONSTRAINT categories_pkey PRIMARY KEY (id),
  CONSTRAINT categories_parent_id_fkey FOREIGN KEY (parent_id) REFERENCES public.categories(id)
);
CREATE TABLE public.products (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  category_id uuid,
  name text NOT NULL CHECK (char_length(btrim(name)) >= 1 AND char_length(btrim(name)) <= 240),
  slug text NOT NULL UNIQUE CHECK (slug ~ '^[a-z0-9]+(-[a-z0-9]+)*$'::text),
  sku text,
  short_description text NOT NULL DEFAULT ''::text,
  description text NOT NULL DEFAULT ''::text,
  price numeric NOT NULL CHECK (price >= 0::numeric),
  currency text NOT NULL DEFAULT 'PKR'::text CHECK (currency ~ '^[A-Z]{3}$'::text),
  specifications jsonb NOT NULL DEFAULT '[]'::jsonb CHECK (jsonb_typeof(specifications) = 'array'::text),
  publication_status USER-DEFINED NOT NULL DEFAULT 'draft'::publication_status,
  is_featured boolean NOT NULL DEFAULT false,
  track_inventory boolean NOT NULL DEFAULT true,
  weight_grams integer CHECK (weight_grams IS NULL OR weight_grams >= 0),
  dimensions jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(dimensions) = 'object'::text),
  seo_title text,
  seo_description text,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  seller_id uuid,
  moderation_status text NOT NULL DEFAULT 'approved'::text CHECK (moderation_status = ANY (ARRAY['pending_review'::text, 'approved'::text, 'rejected'::text, 'hidden'::text, 'archived'::text])),
  moderated_by uuid,
  moderated_at timestamp with time zone,
  moderation_reason text CHECK (moderation_reason IS NULL OR char_length(moderation_reason) <= 1000),
  supplier_cost numeric CHECK (supplier_cost IS NULL OR supplier_cost >= 0::numeric),
  fulfillment_expense numeric NOT NULL DEFAULT 0 CHECK (fulfillment_expense >= 0::numeric),
  minimum_profit numeric NOT NULL DEFAULT 0 CHECK (minimum_profit >= 0::numeric),
  cost_updated_at timestamp with time zone,
  stock_verification_status text NOT NULL DEFAULT 'unverified'::text CHECK (stock_verification_status = ANY (ARRAY['unverified'::text, 'verified'::text, 'stale'::text, 'paused'::text])),
  is_daily_item boolean NOT NULL DEFAULT false,
  daily_available_quantity integer NOT NULL DEFAULT 0 CHECK (daily_available_quantity >= 0),
  daily_minimum_quantity integer NOT NULL DEFAULT 1 CHECK (daily_minimum_quantity >= 1),
  daily_available_on date,
  vendor_hidden boolean NOT NULL DEFAULT false,
  vendor_hidden_at timestamp with time zone,
  food_selling_unit text CHECK (food_selling_unit IS NULL OR (food_selling_unit = ANY (ARRAY['kg'::text, 'g'::text, 'l'::text, 'ml'::text, 'piece'::text, 'dozen'::text, 'pack'::text]))),
  food_quantity_increment integer CHECK (food_quantity_increment IS NULL OR food_quantity_increment > 0),
  food_minimum_quantity integer CHECK (food_minimum_quantity IS NULL OR food_minimum_quantity > 0),
  food_unit_price numeric CHECK (food_unit_price IS NULL OR food_unit_price >= 0::numeric),
  discount_percent numeric NOT NULL DEFAULT 0 CHECK (discount_percent >= 0::numeric AND discount_percent <= 100::numeric),
  daily_status text NOT NULL DEFAULT 'available'::text CHECK (daily_status = ANY (ARRAY['available'::text, 'not_today'::text, 'coming_soon'::text])),
  food_product_type text,
  food_metadata jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(food_metadata) = 'object'::text),
  CONSTRAINT products_pkey PRIMARY KEY (id),
  CONSTRAINT products_category_id_fkey FOREIGN KEY (category_id) REFERENCES public.categories(id),
  CONSTRAINT products_seller_id_fkey FOREIGN KEY (seller_id) REFERENCES public.seller_profiles(id),
  CONSTRAINT products_moderated_by_fkey FOREIGN KEY (moderated_by) REFERENCES auth.users(id)
);
CREATE TABLE public.product_images (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  product_id uuid NOT NULL,
  image_url text CHECK (image_url IS NULL OR image_url ~ '^https://'::text),
  storage_path text CHECK (storage_path IS NULL OR storage_path !~ '^/'::text AND storage_path !~ '(^|/)\.\.?(/|$)'::text),
  alt_text text NOT NULL DEFAULT ''::text,
  sort_order integer NOT NULL DEFAULT 0 CHECK (sort_order >= 0),
  is_primary boolean NOT NULL DEFAULT false,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT product_images_pkey PRIMARY KEY (id),
  CONSTRAINT product_images_product_id_fkey FOREIGN KEY (product_id) REFERENCES public.products(id)
);
CREATE TABLE public.product_variants (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  product_id uuid NOT NULL,
  option_label text NOT NULL CHECK (char_length(btrim(option_label)) >= 1 AND char_length(btrim(option_label)) <= 80),
  option_value text NOT NULL CHECK (char_length(btrim(option_value)) >= 1 AND char_length(btrim(option_value)) <= 120),
  sku text,
  price_override numeric CHECK (price_override IS NULL OR price_override >= 0::numeric),
  attributes jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(attributes) = 'object'::text),
  is_active boolean NOT NULL DEFAULT true,
  sort_order integer NOT NULL DEFAULT 0 CHECK (sort_order >= 0),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT product_variants_pkey PRIMARY KEY (id),
  CONSTRAINT product_variants_product_id_fkey FOREIGN KEY (product_id) REFERENCES public.products(id)
