CREATE TABLE public.buyer_complaints (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  order_id uuid NOT NULL,
  order_item_id uuid,
  buyer_id uuid NOT NULL,
  seller_id uuid,
  case_type text NOT NULL DEFAULT 'complaint'::text CHECK (case_type = ANY (ARRAY['return'::text, 'refund'::text, 'complaint'::text, 'damaged'::text, 'wrong_item'::text])),
